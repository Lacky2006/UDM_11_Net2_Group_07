<Window x:Class="UploadClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-File Upload Client - v1.0"
        Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#EAEAEA"
        AllowDrop="True" Drop="Window_Drop">

	<Window.Resources>
		<!-- Style nút bấm chung: bo góc nhẹ, viền mỏng, giống ảnh mẫu -->
		<Style x:Key="BaseButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="#F5F5F5"/>
			<Setter Property="BorderBrush" Value="#B0B0B0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Foreground" Value="#A0A0A0"/>
					<Setter Property="Background" Value="#E8E8E8"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<!-- Style ô nhập liệu: bo góc nhẹ, nền xám khi disable -->
		<Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
			<Setter Property="BorderBrush" Value="#B0B0B0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="4,0,0,0"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#E0E0E0"/>
					<Setter Property="Foreground" Value="#888888"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="230"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ===================== TIÊU ĐỀ ===================== -->
		<TextBlock Text="MULTI-FILE UPLOAD CLIENT"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

		<Grid Grid.Row="1" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="4*"/>
			</Grid.ColumnDefinitions>

			<!-- ===================== KẾT NỐI SERVER ===================== -->
			<GroupBox Header="KẾT NỐI SERVER" Grid.Column="0" Margin="0,0,5,0" Padding="10">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,5">
						<TextBlock Text="Server IP:" Width="70" VerticalAlignment="Center" FontSize="14"/>
						<TextBox x:Name="txtIP" Text="192.168.1.10" Width="170" Height="25"
                                 Style="{StaticResource BaseTextBoxStyle}"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,5">
						<TextBlock Text="Port:" Width="70" VerticalAlignment="Center" FontSize="14"/>
						<TextBox x:Name="txtPort" Text="5000" Width="170" Height="25"
                                 Style="{StaticResource BaseTextBoxStyle}"
                                 PreviewTextInput="txtPort_PreviewTextInput"/>
					</StackPanel>

					<Button x:Name="btnConnect" Content="Connect" Grid.Row="2" Height="28" Margin="0,10,0,5"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="btnConnect_Click"/>
					<Button x:Name="btnDisconnect" Content="Disconnect" Grid.Row="3" Height="28" Margin="0,0,0,10"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="btnDisconnect_Click"/>

					<StackPanel Orientation="Horizontal" Grid.Row="4">
						<TextBlock Text="Status: " FontSize="14" VerticalAlignment="Center"/>
						<Ellipse x:Name="ellipseStatus" Width="12" Height="12" Fill="Red" Stroke="Gray" VerticalAlignment="Center" Margin="5,0"/>
						<TextBlock x:Name="lblStatus" Text="Disconnected" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
					</StackPanel>
				</Grid>
			</GroupBox>

			<!-- ===================== CHỌN FILE ===================== -->
			<GroupBox Header="CHỌN FILE" Grid.Column="1" Margin="5,0,5,0" Padding="10">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<Button x:Name="btnSelectFile" Content="📁 Select Files" Height="28" Margin="0,0,0,5"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="btnSelectFile_Click"/>
					<Button x:Name="btnClearList" Content="🗑️ Clear List" Grid.Row="1" Height="28" Margin="0,0,0,10"
                            Style="{StaticResource BaseButtonStyle}"
                            Click="btnClearList_Click"/>

					<TextBlock Text="Kéo thả file vào đây"
                               Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               FontSize="13"
                               Foreground="#555555"/>

					<!-- Vùng kéo-thả: bắt sự kiện DragEnter/DragLeave/Drop -->
					<Grid Grid.Row="2" Margin="0,22,0,0" AllowDrop="True"
                          DragEnter="dropZone_DragEnter" DragLeave="dropZone_DragLeave" Drop="dropZone_Drop">
						<Rectangle x:Name="dropZoneRect" Stroke="#A0A0A0" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="White" RadiusX="4" RadiusY="4"/>
						<TextBlock x:Name="lblDropZone" Text="📄 Drag &amp; Drop Files"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#333333"/>
					</Grid>
				</Grid>
			</GroupBox>

			<!-- ===================== TRẠNG THÁI UPLOAD (render động) ===================== -->
			<GroupBox Header="TRẠNG THÁI UPLOAD" Grid.Column="2" Margin="5,0,0,0" Padding="8">
				<ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl x:Name="icUploadStatus" Background="White">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="5,5,5,10" Visibility="{Binding PanelVisibility}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<Rectangle Grid.Column="0" Width="4" Fill="{Binding StatusColor}" Margin="0,2,8,2"/>

									<StackPanel Grid.Column="1">
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding FileIcon}" FontSize="14" Margin="0,0,5,0"/>
											<TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold"/>
										</StackPanel>

										<Grid Margin="0,4">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>
											<ProgressBar Grid.Column="0" Value="{Binding Percent}" Minimum="0" Maximum="100" Height="18"
                                                         Foreground="{Binding StatusColor}"/>
											<TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="11" FontWeight="Bold"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
										</Grid>

										<TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="DimGray"/>
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</GroupBox>
		</Grid>

		<!-- ===================== DANH SÁCH FILE CHỜ UPLOAD ===================== -->
		<GroupBox Header="DANH SÁCH FILE CHỜ UPLOAD" Grid.Row="2" Margin="0,5,0,5" Padding="5">
			<DataGrid x:Name="dgFiles"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="White"
                      HeadersVisibility="Column"
                      CanUserResizeRows="False"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible">
				<DataGrid.Columns>
					<DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50"/>

					<!-- Tên file kèm icon tương ứng loại file -->
					<DataGridTemplateColumn Header="Tên file" Width="2.5*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<TextBlock Text="{Binding FileIcon}" FontSize="14" Margin="0,0,6,0"/>
									<TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTextColumn Header="Dung lượng" Binding="{Binding Size}" Width="1*"/>

					<!-- Trạng thái kèm dấu tròn màu -->
					<DataGridTemplateColumn Header="Trạng thái" Width="130">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,6,0"/>
									<TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTemplateColumn Header="Tiến trình" Width="1.5*">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate>
								<Grid Margin="4,2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<ProgressBar Grid.Column="0" Value="{Binding Percent}" Minimum="0" Maximum="100" Height="16"
                                                 Foreground="{Binding StatusColor}"/>
									<TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="11" FontWeight="Bold"
                                               Margin="6,0,0,0" VerticalAlignment="Center"/>
								</Grid>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</GroupBox>

		<!-- ===================== NÚT ĐIỀU KHIỂN ===================== -->
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
			<Button x:Name="btnUpload" Content="▶ Upload" Width="120" Height="32" Margin="0,0,15,0" FontSize="14"
                    Style="{StaticResource BaseButtonStyle}"
                    Click="btnUpload_Click"/>
			<Button x:Name="btnPause" Content="⏸ Pause" Width="120" Height="32" Margin="0,0,15,0" FontSize="14"
                    Style="{StaticResource BaseButtonStyle}"
                    Click="btnPause_Click"/>
			<Button x:Name="btnResume" Content="▶ Resume" Width="120" Height="32" FontSize="14"
                    Style="{StaticResource BaseButtonStyle}"
                    Click="btnResume_Click"/>
		</StackPanel>
	</Grid>
</Window>
