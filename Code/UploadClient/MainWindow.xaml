<Window x:Class="UploadClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload Client"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        AllowDrop="True"
        Drop="Window_Drop">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="120"/>
		</Grid.RowDefinitions>

		<TextBlock Text="UPLOAD CLIENT"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

		<Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#DADDE1"
                BorderThickness="1">

			<StackPanel>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock Text="Server IP/Host:"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

					<TextBox x:Name="txtIP"
                             Width="170"
                             Height="34"
                             Text="127.0.0.1"
                             ToolTip="Nhập IP/Host của máy Server. Ví dụ: 127.0.0.1, 192.168.1.240 hoặc host ngrok/tailscale."
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Margin="0,0,15,0"/>

					<TextBlock Text="Port:"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

					<TextBox x:Name="txtPort"
                             Width="90"
                             Height="34"
                             Text="9000"
                             MaxLength="5"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             PreviewTextInput="txtPort_PreviewTextInput"
                             Margin="0,0,15,0"/>

					<Button x:Name="btnConnect"
                            Content="Connect"
                            Width="110"
                            Height="34"
                            FontSize="14"
                            Margin="0,0,8,0"
                            Click="btnConnect_Click"/>

					<Button x:Name="btnDisconnect"
                            Content="Disconnect"
                            Width="120"
                            Height="34"
                            FontSize="14"
                            Click="btnDisconnect_Click"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" Margin="0,12,0,0">
					<TextBlock Text="Status:"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

					<TextBlock x:Name="lblStatus"
                               Text="Disconnected"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="Red"
                               VerticalAlignment="Center"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#DADDE1"
                BorderThickness="1">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<StackPanel Orientation="Horizontal">
					<Button x:Name="btnSelectFile"
                            Content="Select Files"
                            Width="120"
                            Height="35"
                            FontSize="14"
                            Margin="0,0,10,0"
                            Click="btnSelectFile_Click"/>

					<Button x:Name="btnUpload"
                            Content="Upload All"
                            Width="120"
                            Height="35"
                            FontSize="14"
                            Margin="0,0,10,0"
                            Click="btnUpload_Click"/>

					<Button x:Name="btnClearList"
                            Content="Clear List"
                            Width="110"
                            Height="35"
                            FontSize="14"
                            Click="btnClearList_Click"/>
				</StackPanel>

				<Grid Grid.Row="1" Margin="0,12,0,12" Height="64">
					<Rectangle x:Name="dropZoneRect"
                               RadiusX="8"
                               RadiusY="8"
                               Stroke="#B0B6BD"
                               StrokeThickness="2"
                               StrokeDashArray="4 2"
                               Fill="#FAFBFC"/>

					<Border AllowDrop="True"
                            Background="Transparent"
                            DragEnter="dropZone_DragEnter"
                            DragLeave="dropZone_DragLeave"
                            Drop="dropZone_Drop">
						<TextBlock x:Name="lblDropZone"
                                   Text="📂  Kéo và thả file vào đây để thêm vào danh sách upload"
                                   FontSize="14"
                                   Foreground="#7A8088"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
					</Border>
				</Grid>

				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="15"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Danh sách file chờ upload:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

					<TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="File đã upload:"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

					<ListBox x:Name="lstFiles"
                             Grid.Row="1"
                             Grid.Column="0"
                             SelectionMode="Single"
                             FontSize="13"
                             HorizontalContentAlignment="Stretch"/>

					<ListBox x:Name="lstUploadedFiles"
                             Grid.Row="1"
                             Grid.Column="2"
                             SelectionMode="Single"
                             FontSize="13"
                             HorizontalContentAlignment="Stretch"/>
				</Grid>
			</Grid>
		</Border>

		<Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#DADDE1"
                BorderThickness="1">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto" MinWidth="70"/>
				</Grid.ColumnDefinitions>

				<ProgressBar x:Name="progressUpload"
                             Height="28"
                             Minimum="0"
                             Maximum="100"
                             Margin="0,0,15,0"/>
				<TextBlock x:Name="lblProgress"
                           Grid.Column="1"
                           Text="0%"
                           FontSize="15"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
			</Grid>
		</Border>

		<Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                Padding="10"
                BorderBrush="#DADDE1"
                BorderThickness="1">

			<TextBox x:Name="txtLog"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14"
                     Background="#FAFAFA"/>
		</Border>
	</Grid>
</Window>
