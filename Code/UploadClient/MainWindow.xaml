<Window x:Class="UploadClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upload Client"
        Height="560"
        Width="780"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8">

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
                   Text="UPLOAD CLIENT"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,20"/>

		<!-- Connection Panel -->
		<Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#DADDE1"
                BorderThickness="1">

			<StackPanel>
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center">

					<TextBlock Text="Server IP:"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

					<TextBox x:Name="txtIP"
                             Width="140"
                             Height="34"
                             Text="127.0.0.1"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Margin="0,0,15,0"/>

					<TextBlock Text="Port:"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

					<TextBox x:Name="txtPort"
                             Width="90"
                             Height="34"
                             Text="9000"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             Margin="0,0,15,0"/>

					<Button x:Name="btnConnect"
                            Content="Connect"
                            Width="110"
                            Height="34"
                            FontSize="14"
                            Margin="0,0,8,0"
                            Click="btnConnect_Click"/>

					<Button x:Name="btnDisconnect"
                            Content="Disconnect"
                            Width="120"
                            Height="34"
                            FontSize="14"
                            IsEnabled="False"
                            Click="btnDisconnect_Click"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" Margin="0,12,0,0">
					<TextBlock Text="Status:"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

					<TextBlock x:Name="lblStatus"
                               Text="Disconnected"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="Red"
                               VerticalAlignment="Center"/>
				</StackPanel>
			</StackPanel>
		</Border>

		<!-- File Panel -->
		<Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#DADDE1"
                BorderThickness="1">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Orientation="Horizontal">

					<Button x:Name="btnSelectFile"
                            Content="Select File"
                            Width="120"
                            Height="35"
                            FontSize="14"
                            Margin="0,0,10,0"
                            IsEnabled="False"
                            Click="btnSelectFile_Click"/>

					<Button x:Name="btnUpload"
                            Content="Upload File"
                            Width="120"
                            Height="35"
                            FontSize="14"
                            IsEnabled="False"
                            Click="btnUpload_Click"/>
				</StackPanel>

				<TextBox x:Name="txtSelectedFile"
                         Grid.Row="1"
                         Height="34"
                         Margin="0,12,0,0"
                         IsReadOnly="True"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Text="Chưa chọn file..."/>
			</Grid>
		</Border>

		<!-- Progress Panel -->
		<Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#DADDE1"
                BorderThickness="1">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="70"/>
				</Grid.ColumnDefinitions>

				<ProgressBar x:Name="progressUpload"
                             Grid.Column="0"
                             Height="28"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>

				<TextBlock x:Name="lblProgress"
                           Grid.Column="1"
                           Text="0%"
                           FontSize="15"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
			</Grid>
		</Border>

		<!-- Log -->
		<Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                Padding="10"
                BorderBrush="#DADDE1"
                BorderThickness="1">

			<TextBox x:Name="txtLog"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14"
                     Background="#FAFAFA"/>
		</Border>
	</Grid>
</Window>