<Window x:Class="UploadClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-File Upload Client - v1.0"
        Height="720"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        AllowDrop="True"
        Drop="Window_Drop">

	<Window.Resources>
		<Style x:Key="BaseButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="36"/>
			<Setter Property="Padding" Value="12,0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="#F5F5F5"/>
			<Setter Property="BorderBrush" Value="#B0B0B0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#E9EEF5"/>
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Foreground" Value="#8A8F98"/>
					<Setter Property="Background" Value="#E6E6E6"/>
					<Setter Property="BorderBrush" Value="#CCCCCC"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
			<Setter Property="Background" Value="#DDEBFF"/>
			<Setter Property="BorderBrush" Value="#8DB9F5"/>
			<Setter Property="Foreground" Value="#1F4E79"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>

		<Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
			<Setter Property="Height" Value="34"/>
			<Setter Property="Padding" Value="6,0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="BorderBrush" Value="#B0B0B0"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Style.Triggers>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Background" Value="#E5E5E5"/>
					<Setter Property="Foreground" Value="#777777"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
                   Text="MULTI-FILE UPLOAD CLIENT"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

		<Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                BorderBrush="#DADDE1"
                BorderThickness="1">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="180"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="100"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<TextBlock Grid.Row="0" Grid.Column="0" Text="Server IP/Host:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
				<TextBox x:Name="txtIP"
                         Grid.Row="0" Grid.Column="1"
                         Text=""
                         ToolTip="Nhập IP/Host của Server. Ví dụ: 127.0.0.1, 192.168.1.240, host ngrok hoặc IP Tailscale."
                         Style="{StaticResource BaseTextBoxStyle}"
                         Margin="0,0,18,0"/>

				<TextBlock Grid.Row="0" Grid.Column="2" Text="Port:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
				<TextBox x:Name="txtPort"
                         Grid.Row="0" Grid.Column="3"
                         Text="9000"
                         MaxLength="5"
                         PreviewTextInput="txtPort_PreviewTextInput"
                         Style="{StaticResource BaseTextBoxStyle}"
                         Margin="0,0,18,0"/>

				<Button x:Name="btnConnect"
                        Grid.Row="0" Grid.Column="4"
                        Content="Connect"
                        Width="110"
                        Click="btnConnect_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0"/>

				<Button x:Name="btnDisconnect"
                        Grid.Row="0" Grid.Column="5"
                        Content="Disconnect"
                        Width="120"
                        Click="btnDisconnect_Click"
                        Style="{StaticResource BaseButtonStyle}"/>

				<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="0,12,0,0">
					<TextBlock Text="Status:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<Ellipse x:Name="ellipseStatus" Width="12" Height="12" Fill="Red" VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBlock x:Name="lblStatus" Text="Disconnected" FontSize="14" FontWeight="SemiBold" Foreground="Red" VerticalAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="2*"/>
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="White"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15"
                    BorderBrush="#DADDE1"
                    BorderThickness="1">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
						<Button x:Name="btnSelectFile" Content="Select Files" Width="120" Click="btnSelectFile_Click" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
						<Button x:Name="btnUpload" Content="Upload All" Width="120" Click="btnUpload_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,10,0"/>
						<Button x:Name="btnPause" Content="Pause" Width="90" Click="btnPause_Click" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
						<Button x:Name="btnResume" Content="Resume" Width="90" Click="btnResume_Click" Style="{StaticResource BaseButtonStyle}" Margin="0,0,10,0"/>
						<Button x:Name="btnClearList" Content="Clear List" Width="110" Click="btnClearList_Click" Style="{StaticResource BaseButtonStyle}"/>
					</StackPanel>

					<Border Grid.Row="1"
                            CornerRadius="6"
                            Background="#FAFAFA"
                            AllowDrop="True"
                            DragEnter="dropZone_DragEnter"
                            DragLeave="dropZone_DragLeave"
                            Drop="dropZone_Drop">
						<Grid Height="70">
							<Rectangle x:Name="dropZoneRect"
                                       Stroke="#A0A0A0"
                                       StrokeThickness="1.5"
                                       StrokeDashArray="6 4"
                                       RadiusX="6"
                                       RadiusY="6"/>
							<TextBlock x:Name="lblDropZone"
                                       Text="📁 Kéo và thả file vào đây để thêm vào danh sách upload"
                                       Foreground="#333333"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
						</Grid>
					</Border>
				</Grid>
			</Border>

			<GroupBox Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Header="DANH SÁCH FILE CHỜ UPLOAD" Padding="8" Background="White" BorderBrush="#DADDE1">
				<DataGrid x:Name="dgFiles"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          SelectionMode="Single">
					<DataGrid.Columns>
						<DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50"/>
						<DataGridTextColumn Header="Loại" Binding="{Binding FileIcon}" Width="55"/>
						<DataGridTextColumn Header="Tên file" Binding="{Binding FileName}" Width="*"/>
						<DataGridTextColumn Header="Dung lượng" Binding="{Binding Size}" Width="110"/>
						<DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120"/>
						<DataGridTextColumn Header="Tiến độ" Binding="{Binding PercentText}" Width="80"/>
					</DataGrid.Columns>
				</DataGrid>
			</GroupBox>

			<GroupBox Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Header="TRẠNG THÁI UPLOAD" Padding="8" Background="White" BorderBrush="#DADDE1">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ItemsControl x:Name="icUploadStatus">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Visibility="{Binding PanelVisibility}"
                                        BorderBrush="#E1E4E8"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,0,0,8"
                                        Background="#FBFBFB">
									<Grid>
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<Ellipse Grid.Row="0" Grid.Column="0" Width="12" Height="12" Fill="{Binding StatusColor}" Margin="0,4,8,0"/>
										<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
										<TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PercentText}" FontWeight="SemiBold" Margin="8,0,0,0"/>

										<StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
											<ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Percent}" Foreground="{Binding StatusColor}"/>
											<TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="#666666" Margin="0,4,0,0"/>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</GroupBox>
		</Grid>
	</Grid>
</Window>
