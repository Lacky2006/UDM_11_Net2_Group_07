<Window x:Class="UploadServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-File Upload Server - v1.0"
        Height="550" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#EAEAEA">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="240"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="0,0,0,10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="3.5*"/>
				<ColumnDefinition Width="3.5*"/>
			</Grid.ColumnDefinitions>

			<GroupBox Header="CẤU HÌNH SERVER" Grid.Column="0" Margin="0,0,5,0" Padding="10">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,5">
						<TextBlock Text="IP:" Width="45" VerticalAlignment="Center" FontSize="14"/>
						<TextBox x:Name="txtIP" Width="180" Height="25" VerticalContentAlignment="Center"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,5">
						<TextBlock Text="Port:" Width="45" VerticalAlignment="Center" FontSize="14"/>
						<TextBox x:Name="txtPort" Text="9000" Width="180" Height="25" VerticalContentAlignment="Center" PreviewTextInput="txtPort_PreviewTextInput"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,15,0,5" HorizontalAlignment="Center">
						<Button x:Name="btnStart" Content="[ Start Server ]" Width="110" Height="30" Margin="0,0,10,0" Click="btnStart_Click"/>
						<Button x:Name="btnStop" Content="[ Stop Server ]" Width="110" Height="30" Click="btnStop_Click"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,5,0,0">
						<TextBlock x:Name="lblServerStatus" Text="Status: Offline" VerticalAlignment="Center" FontSize="14" Margin="0,0,5,0"/>
						<Ellipse x:Name="ellServerStatus" Width="15" Height="15" Fill="Red" Stroke="Gray" VerticalAlignment="Center"/>
					</StackPanel>
				</Grid>
			</GroupBox>

			<GroupBox Header="CLIENT ĐANG KẾT NỐI" Grid.Column="1" Margin="5,0,5,0" Padding="5">
				<DataGrid x:Name="lvClients"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="None"
                          Background="White"
                          HeadersVisibility="Column"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Visible">
					<DataGrid.Columns>
						<DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="60"/>
						<DataGridTextColumn Header="IP Client" Binding="{Binding IPClient}" Width="*"/>
					</DataGrid.Columns>
				</DataGrid>
			</GroupBox>

			<GroupBox Header="LOG HOẠT ĐỘNG" Grid.Column="2" Margin="5,0,0,0" Padding="5">
				<TextBox x:Name="txtLog" IsReadOnly="True" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible"
                         Background="White" BorderThickness="1" BorderBrush="#CCCCCC"
                         FontFamily="Consolas" FontSize="12"/>
			</GroupBox>
		</Grid>

		<GroupBox Header="FILE ĐÃ NHẬN" Grid.Row="1" Margin="0,5,0,0" Padding="5">
			<DataGrid x:Name="lvReceivedFiles"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="None"
                      Background="White"
                      HeadersVisibility="Column"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible">
				<DataGrid.Columns>
					<DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="55"/>
					<DataGridTextColumn Header="IP Client" Binding="{Binding IPClient}" Width="140"/>
					<DataGridTextColumn Header="Tên file" Binding="{Binding FileName}" Width="2*"/>
					<DataGridTextColumn Header="Dung lượng" Binding="{Binding Size}" Width="1*"/>
					<DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110"/>
					<DataGridTextColumn Header="Thời gian nhận" Binding="{Binding ReceivedTime}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</GroupBox>

		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5,5,5,0">
			<TextBlock x:Name="lblClientCount" Text="0 Client(s) connected" Margin="0,0,20,0" FontSize="13" FontWeight="SemiBold"/>
			<TextBlock x:Name="lblTotalFiles" Text="Total files: 0" FontSize="13" FontWeight="SemiBold"/>
		</StackPanel>
	</Grid>
</Window>
