<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color tokens -->
    <Color x:Key="ColorBackground">#FF121317</Color>
    <Color x:Key="ColorCard">#FF1E2024</Color>
    <Color x:Key="ColorSurface">#FF25262A</Color>
    <Color x:Key="ColorSurfaceAlt">#FF2A2C31</Color>
    <Color x:Key="ColorPrimary">#FF4FC3F7</Color>
    <Color x:Key="ColorAccent">#FF1EAEDB</Color>
    <Color x:Key="ColorTextPrimary">#FFE6EEF3</Color>
    <Color x:Key="ColorTextSecondary">#FFAAB6C3</Color>
    <Color x:Key="ColorSuccess">#FF4CAF50</Color>
    <Color x:Key="ColorWarning">#FFFFB300</Color>
    <Color x:Key="ColorDanger">#FFF44336</Color>
    <Color x:Key="ColorBorder">#FF2F3136</Color>
    <Color x:Key="ColorInputBg">#FF252526</Color>
    <Color x:Key="ColorInputFg">#FFE0E0E0</Color>
    <Color x:Key="ColorInputBorder">#FF4A4A4A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource ColorInputBg}" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="{StaticResource ColorInputFg}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource ColorInputBorder}" />
    <SolidColorBrush x:Key="LogForegroundBrush" Color="{StaticResource ColorInputFg}" />
    <SolidColorBrush x:Key="DataGridForegroundBrush" Color="{StaticResource ColorInputFg}" />

    <!-- Button styles -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- ProgressBar styles -->
    <Style x:Key="AccentProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    </Style>

    <Style x:Key="SmallProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
    </Style>

</ResourceDictionary>