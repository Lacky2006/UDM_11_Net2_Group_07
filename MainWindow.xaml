<Window x:Class="UploadClient.MainWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Multi-File Upload Client - v1.0" Width="1100" Height="650" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <DockPanel Margin="0" Background="#F8F9FA">
        <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="15">
            <TextBlock Text="MULTI-FILE UPLOAD CLIENT" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="15" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnUpload" Content="▶  Start Upload" Width="160" Height="40" FontSize="15" FontWeight="SemiBold" Background="#28A745" Foreground="White" Margin="10,0" IsEnabled="False" Click="btnUpload_Click"/>
                <Button x:Name="btnPause" Content="⏸  Pause" Width="140" Height="40" FontSize="15" FontWeight="SemiBold" Background="#FFC107" Foreground="Black" Margin="10,0" IsEnabled="False" Click="btnPause_Click"/>
                <Button x:Name="btnResume" Content="▶  Resume" Width="140" Height="40" FontSize="15" FontWeight="SemiBold" Background="#17A2B8" Foreground="White" Margin="10,0" IsEnabled="False" Click="btnResume_Click"/>
            </StackPanel>
        </Border>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="280"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="KẾT NỐI SERVER" Grid.Column="0" FontSize="14" FontWeight="Bold" Margin="5" Padding="10" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Server IP:" Grid.Row="0" Grid.Column="0" FontSize="14" FontWeight="Normal" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtServerIp" Grid.Row="0" Grid.Column="1" Height="28" FontSize="14" VerticalAlignment="Center" TextChanged="Input_TextChanged"/>
                        <TextBlock Text="Port:" Grid.Row="1" Grid.Column="0" FontSize="14" FontWeight="Normal" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPort" Grid.Row="1" Grid.Column="1" Height="28" FontSize="14" VerticalAlignment="Center" TextChanged="Input_TextChanged" PreviewTextInput="txtPort_PreviewTextInput"/>
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,15,0,10">
                            <Button x:Name="btnConnect" Content="Connect" Height="32" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" IsEnabled="False" Click="btnConnect_Click"/>
                            <Button x:Name="btnDisconnect" Content="Disconnect" Height="32" FontSize="14" FontWeight="SemiBold" IsEnabled="False" Click="btnDisconnect_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                            <Ellipse x:Name="statusLed" Width="14" Height="14" Fill="#DC3545" Stroke="#B52A37" StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Status:" FontSize="14" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="txtStatus" Text="Disconnected" FontSize="14" Foreground="#DC3545" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="QUẢN LÝ TẬP TIN" Grid.Column="1" FontSize="14" FontWeight="Bold" Margin="5" Padding="10" Background="White">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnSelectFiles" Content="📁 Select Files" Grid.Column="0" Height="32" FontSize="13" Margin="0,0,5,0" Click="btnSelectFiles_Click"/>
                            <Button x:Name="btnClearList" Content="🗑  Clear List" Grid.Column="1" Height="32" FontSize="13" Margin="5,0,0,0" IsEnabled="False" Click="btnClearList_Click"/>
                        </Grid>
                        <Grid x:Name="dropZone" AllowDrop="True" Drop="dropZone_Drop" DragOver="dropZone_Drop" Background="#F1F3F5">
                            <Rectangle Stroke="#007BFF" StrokeThickness="2" StrokeDashArray="4 3" RadiusX="6" RadiusY="6"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Kéo thả file vào đây" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#007BFF"/>
                                <TextBlock Text="✦ Drag &amp; Drop Files ✦" HorizontalAlignment="Center" FontSize="13" Foreground="#6C757D" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="TIẾN TRÌNH GỬI FILE" Grid.Column="2" FontSize="14" FontWeight="Bold" Margin="5" Padding="5" Background="White">
                    <ListBox x:Name="lstUploading" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" Padding="8" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <Grid Margin="0,6,0,4">
                                                <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding Progress}" Background="#E9ECEF" Foreground="#28A745"/>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                                            </Grid>
                                            <TextBlock Text="{Binding SubText}" FontSize="12" Foreground="#6C757D"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✕" Width="26" Height="26" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="#DC3545" Tag="{Binding}" Click="btnCancelUploadItem_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>
            <Border Grid.Row="1" Background="#E9ECEF" Padding="10" Margin="5,10,5,0" CornerRadius="4,4,0,0">
                <TextBlock Text="📋 FILE ĐÃ NHẬN" FontSize="15" FontWeight="Bold" Foreground="#495057"/>
            </Border>

            <DataGrid x:Name="dgWaitingFiles" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" FontSize="14" Margin="5,0,5,5" Background="White" BorderBrush="#E9ECEF" RowHeight="32">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F3F5"/>
                        <Setter Property="Foreground" Value="#495057"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="BorderBrush" Value="#E9ECEF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="60"/>
                    <DataGridTextColumn Header="Tên file" Binding="{Binding FileName}" Width="250"/>
                    <DataGridTextColumn Header="Dung lượng" Binding="{Binding SizeText}" Width="*"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="150"/>
                    <DataGridTextColumn Header="Thời gian nhận" Binding="{Binding ProgressText}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
